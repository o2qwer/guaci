        '5_2': { name: '风泽中孚', jing: '中孚豚鱼吉', xiang: '诚信中正，信及豚鱼', zhi: '以诚为本，感化万物 '},
        '5_3': { name: '风火家人', jing: '家人利女贞', xiang: '家道正齐，修身齐家', zhi: '治家有方，内外和睦 '},
        '5_4': { name: '风雷益', jing: '益利有攸往', xiang: '损上益下，迁善改过', zhi: '增益进取，利国利民 '},
        '5_5': { name: '巽为风', jing: '巽小亨利有攸', xiang: '柔顺深入，谦逊而行', zhi: '以柔克刚，谦逊得益 '},
        '5_6': { name: '风水涣', jing: '涣亨王假有庙', xiang: '涣散离析，聚而合之', zhi: '散而复聚，重建秩序 '},
        '5_7': { name: '风山渐', jing: '渐女归吉利贞', xiang: '循序渐进，稳步前行', zhi: '循序渐进，终达目标 '},
        '5_8': { name: '风地观', jing: '观盥而不荐', xiang: '观察审视，以教化人', zhi: '观而不动，静观其变 '},
        '6_1': { name: '水天需', jing: '需有孚光亨', xiang: '待时而动守正需等待', zhi: '耐心等待，时机将至 '},
        '6_2': { name: '水泽节', jing: '节亨苦节不可', xiang: '节制有度，不可过度', zhi: '适当节制，过则反凶 '},
        '6_3': { name: '水火既济', jing: '既济亨小利贞', xiang: '事已完成，守成防衰', zhi: '功成事毕，须防衰败 '},
