    29, 0, 0, 30, 0, 0, 29, 0, 0, 29,
    0
  ]

  // 月大小位掩码：bit m-1 = 1 表示第m月30天，= 0 表示29天
  const LUNAR_MONTH_BITS_2020 = [
    0xa9e, 0x556, 0xab5, 0xada, 0x6d2, 0x765, 0x725, 0x64b, 0x657, 0xcab,
    0x55a, 0x56e, 0xb69, 0xf52, 0xb52, 0xb25, 0xd0b, 0xa4b, 0x4ab, 0x2bb,
