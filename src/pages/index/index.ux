  const MONTH_BIT = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048]

  // 预计算：从农历1900-01-01到2020年的总天数（跳转起点）
  const LUNAR_CUM_2020 = 43823

  // ===== 惰性初始化：仅在实际需要时创建大数组 =====

