        '8_3': { name: '地火明夷', jing: '明夷利艰贞', xiang: '光明受伤，韬光养晦', zhi: '明入地中，隐忍待时 '},
        '8_4': { name: '地雷复', jing: '复亨出入无疾', xiang: '一阳来复，否极泰来', zhi: '转机初现，生机复苏 '},
        '8_5': { name: '地风升', jing: '升元亨用见大', xiang: '上升进取，积小成大', zhi: '稳步上升，前途可期 '},
        '8_6': { name: '地水师', jing: '师贞丈人吉', xiang: '兵师征战，以正治军', zhi: '以正率众，纪律严明 '},
        '8_7': { name: '地山谦', jing: '谦亨君子有终', xiang: '谦逊有礼，卑以自牧', zhi: '谦德受益，功成不骄 '},
        '8_8': { name: '坤为地', jing: '坤元亨利牝马', xiang: '坤顺柔厚，厚德载物', zhi: '柔顺包容，厚德载物' }
      }
    }
    return yiJingDBCache
  }

  // ===== 农历转换（2020+ 快速路径，零位运算循环） =====

  function isSolarLeap(y) {
    return (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0)
  }

  // 公式计算天数偏移（替代逐年循环），用累计表替代月份循环
  function solarDaysFrom1900(sY, sM, sD) {
    const yDiff = sY - 1900
    const leapCount = ((sY - 1) / 4 | 0) - ((sY - 1) / 100 | 0) + ((sY - 1) / 400 | 0) - 460
    const cum = isSolarLeap(sY) ? SOLAR_CUM_LEAP : SOLAR_CUM_DAYS
    return yDiff * 365 + leapCount + cum[sM - 1] + sD - 1
  }

  // 农历月份天数（2020+ 用预计算位掩码，Pre-2020 用 LUNAR_INFO 位运算）
  function lunarMonthDaysFast(y, m) {
    if (y >= 2020) {
      return (LUNAR_MONTH_BITS_2020[y - 2020] & MONTH_BIT[m - 1]) ? 30 : 29
    }
    return (getLunarInfo()[y - 1900] & (0x10000 >> m)) ? 30 : 29
  }

  // 公历转农历（优化版：2020+ 使用预计算扁平数组，Pre-2020 回退到 LUNAR_INFO）
  function solarToLunar(sY, sM, sD) {
    let offset = solarDaysFrom1900(sY, sM, sD) - 30

    // 2020+ 快速路径：使用预计算数组，零位运算循环
    let lY, leap, isLeap = false, lM

    if (offset >= LUNAR_CUM_2020) {
      // 从2020年跳转搜索（约6次迭代，每次只读一个整数）
      offset -= LUNAR_CUM_2020
      for (lY = 2020; lY < 2101; lY++) {
        let yd = LUNAR_YEAR_DAYS_2020[lY - 2020]
        if (offset < yd) break
        offset -= yd
      }
      // 闰月和闰月天数直接从预计算数组读取
      const idx = lY - 2020
      leap = LUNAR_LEAP_MONTH_2020[idx]
      const leapDayCount = LUNAR_LEAP_DAYS_2020[idx]

      for (lM = 1; lM <= 12; lM++) {
        let days
        if (leap > 0 && lM === leap) {
          days = lunarMonthDaysFast(lY, lM)
          if (offset < days) break
          offset -= days
          if (offset < leapDayCount) { isLeap = true; break }
          offset -= leapDayCount
        } else {
          days = lunarMonthDaysFast(lY, lM)
          if (offset < days) break
          offset -= days
        }
      }
    } else {
      // Pre-2020 回退路径（极少触发）
      const LI = getLunarInfo()
      for (lY = 1900; lY < 2020; lY++) {
        let info = LI[lY - 1900]
        let sum = 348
        for (let i = 0x8000; i > 0x8; i >>= 1) { sum += (info & i) ? 1 : 0 }
        let lm = info & 0xf
        if (lm) { sum += (info & 0x10000) ? 30 : 29 }
        if (offset < sum) break
        offset -= sum
      }
      leap = LI[lY - 1900] & 0xf
      let leapDayCount = leap ? ((LI[lY - 1900] & 0x10000) ? 30 : 29) : 0

      for (lM = 1; lM <= 12; lM++) {
        let days
        if (leap > 0 && lM === leap) {
          days = (LI[lY - 1900] & (0x10000 >> lM)) ? 30 : 29
          if (offset < days) break
          offset -= days
          if (offset < leapDayCount) { isLeap = true; break }
          offset -= leapDayCount
        } else {
          days = (LI[lY - 1900] & (0x10000 >> lM)) ? 30 : 29
          if (offset < days) break
          offset -= days
        }
      }
    }

    return { year: lY, month: lM, day: offset + 1, isLeap: isLeap }
  }

  // ===== 干支计算 =====

  function getGanZhiYear(y) {
    return TIANGAN[(y - 4) % 10] + DIZHI[(y - 4) % 12] + '年'
  }

  // 节气月序号（用累计天数替代月份循环）
  function getJieQiMonthNum(y, m, d) {
    const cum = isSolarLeap(y) ? SOLAR_CUM_LEAP : SOLAR_CUM_DAYS
    const doy = cum[m - 1] + d
    if (doy < 6) return 11
    if (doy < 35) return 12
    if (doy < 66) return 1
    if (doy < 96) return 2
    if (doy < 127) return 3
    if (doy < 157) return 4
    if (doy < 188) return 5
    if (doy < 220) return 6
    if (doy < 252) return 7
    if (doy < 283) return 8
    if (doy < 313) return 9
    if (doy < 344) return 10
    return 11
  }

  function getGanZhiMonth(y, m, d) {
    const jqMonth = getJieQiMonthNum(y, m, d)
    const yearGIdx = (y - 4) % 10
    const m1GIdx = (yearGIdx % 5) * 2 + 2
    return TIANGAN[(m1GIdx + jqMonth - 1) % 10] + DIZHI[(jqMonth + 1) % 12] + '月'
  }

  function getGanZhiDay(y, m, d) {
    const days = solarDaysFrom1900(y, m, d)
    const idx = (days + 10) % 60
    return TIANGAN[idx % 10] + DIZHI[idx % 12] + '日'
  }

  // ===== 八卦数学公式（替代查找表和搜索循环） =====

  // 爻线数组 → 八卦序号：num = 8 - (a*4 + b*2 + c)
  // 验证：乾[1,1,1]=8-7=1, 兑[1,1,0]=8-6=2, 坤[0,0,0]=8-0=8
  function linesToNum(a, b, c) {
    return 8 - (a * 4 + b * 2 + c)
  }

  // 八卦序号 → 爻线数组：bv = 8-num, lines = [bv>>2 & 1, bv>>1 & 1, bv & 1]
  // 验证：num=1, bv=7, [1,1,1]; num=8, bv=0, [0,0,0]
  function numToLines(num) {
    const bv = 8 - num
    return [(bv >> 2) & 1, (bv >> 1) & 1, bv & 1]
  }

  export default {
    private: {
      showResult: false,
      showLunar: false,
      showBagua: false,
      selectedGua: 'ben',
      benGua: { name: '', jing: '', xiang: '', zhi: '', upperImg: '', lowerImg: '' },
      huGua: { name: '', jing: '', xiang: '', zhi: '', upperImg: '', lowerImg: '' },
      bianGua: { name: '', jing: '', xiang: '', zhi: '', upperImg: '', lowerImg: '' },
      dongYao: 0,
      currentName: '',
      currentJing: '',
      currentXiang: '',
      currentZhi: '',
      benLabelClass: 'gua-label-active',
      huLabelClass: 'gua-label-normal',
      bianLabelClass: 'gua-label-normal',
      lunarDateStr: '',
      ganZhiYear: '',
      ganZhiMonth: '',
      ganZhiDay: '',
      shiChenName: '',
      solarDateStr: ''
    },

    onInit() {
      // 不在启动时计算，延迟到用户点击按钮时
    },

    updateTimeInfo() {
      const now = new Date()
      const y = now.getFullYear()
      const m = now.getMonth() + 1
      const d = now.getDate()
      const h = now.getHours()

      const lunar = solarToLunar(y, m, d)
      let lunarMonth = LUNAR_MONTH_NAME[lunar.month - 1] + '月'
      if (lunar.isLeap) { lunarMonth = '闰' + lunarMonth }
      this.lunarDateStr = lunarMonth + LUNAR_DAY_NAME[lunar.day - 1]
      this.ganZhiYear = getGanZhiYear(y)
      this.ganZhiMonth = getGanZhiMonth(y, m, d)
      this.ganZhiDay = getGanZhiDay(y, m, d)

      // 时辰名
      const dzIdx = Math.floor((h + 1) / 2) % 12
      this.shiChenName = DIZHI[dzIdx] + '时'

      // 公历日期显示
      this.solarDateStr = y + '年' + m + '月' + d + '日'
    },

    showLunarView() {
      this.updateTimeInfo()
      this.showLunar = true
    },

    goBackFromLunar() {
      this.showLunar = false
    },

    showBaguaView() {
      this.showBagua = true
    },

    goBackFromBagua() {
      this.showBagua = false
    },

    // 设置当前显示的三段卦辞
    setCurrentFortune(gua) {
      this.currentName = gua.name
      this.currentJing = gua.jing
      this.currentXiang = gua.xiang
      this.currentZhi = gua.zhi
    },

    doDivinate() {
      const now = new Date()
      const year = now.getFullYear()
      const month = now.getMonth() + 1
      const day = now.getDate()
      const hour = now.getHours()

      let upperNum = (year + month + day) % 8
      if (upperNum === 0) { upperNum = 8 }
      let lowerNum = (year + month + day + hour) % 8
      if (lowerNum === 0) { lowerNum = 8 }
      let dongYao = (year + month + day + hour) % 6
      if (dongYao === 0) { dongYao = 6 }

      const DB = getYiJingDB()
      const benKey = upperNum + '_' + lowerNum
      const benGua = DB[benKey]

      const lowerLines = numToLines(lowerNum)
      const upperLines = numToLines(upperNum)
      const hexLines = [
        lowerLines[0], lowerLines[1], lowerLines[2],
        upperLines[0], upperLines[1], upperLines[2]
      ]

      const huLowerNum = linesToNum(hexLines[1], hexLines[2], hexLines[3])
      const huUpperNum = linesToNum(hexLines[2], hexLines[3], hexLines[4])
      const huKey = huUpperNum + '_' + huLowerNum
      const huGua = DB[huKey]

      const bianLines = hexLines.slice()
      bianLines[dongYao - 1] = bianLines[dongYao - 1] === 1 ? 0 : 1
      const bianLowerNum = linesToNum(bianLines[0], bianLines[1], bianLines[2])
      const bianUpperNum = linesToNum(bianLines[3], bianLines[4], bianLines[5])
      const bianKey = bianUpperNum + '_' + bianLowerNum
      const bianGua = DB[bianKey]

      function makeGuaObj(gua, upN, lowN) {
        return {
          name: gua.name,
          jing: gua.jing,
          xiang: gua.xiang,
          zhi: gua.zhi,
          upperImg: TRIGRAM_IMG[upN],
          lowerImg: TRIGRAM_IMG[lowN]
        }
      }

      this.benGua = makeGuaObj(benGua, upperNum, lowerNum)
      this.huGua = makeGuaObj(huGua, huUpperNum, huLowerNum)
      this.bianGua = makeGuaObj(bianGua, bianUpperNum, bianLowerNum)
      this.dongYao = dongYao
      this.selectedGua = 'ben'
      this.setCurrentFortune(benGua)
      this.benLabelClass = 'gua-label-active'
      this.huLabelClass = 'gua-label-normal'
      this.bianLabelClass = 'gua-label-normal'
      this.showResult = true
    },

    selectGua(type) {
      this.selectedGua = type
      this.benLabelClass = type === 'ben' ? 'gua-label-active' : 'gua-label-normal'
      this.huLabelClass = type === 'hu' ? 'gua-label-active' : 'gua-label-normal'
      this.bianLabelClass = type === 'bian' ? 'gua-label-active' : 'gua-label-normal'
      let gua
      if (type === 'ben') { gua = this.benGua }
      else if (type === 'hu') { gua = this.huGua }
      else { gua = this.bianGua }
      this.setCurrentFortune(gua)
    },

    goBack() {
      this.showResult = false
      this.showLunar = false
      this.selectedGua = 'ben'
      this.currentJing = ''
      this.currentXiang = ''
      this.currentZhi = ''
      this.currentName = ''
      this.benLabelClass = 'gua-label-active'
      this.huLabelClass = 'gua-label-normal'
      this.bianLabelClass = 'gua-label-normal'
    }
  }
</script>
